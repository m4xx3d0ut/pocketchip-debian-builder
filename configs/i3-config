set $mod Mod1
font pango:DejaVu Sans Mono 7

floating_modifier $mod
focus_follows_mouse no
mouse_warping none
workspace_auto_back_and_forth yes
default_border pixel 1
default_floating_border pixel 1
hide_edge_borders smart
title_align center

set $term xterm -bg black -fg green -cr green -fa "DejaVu Sans Mono" -fs 7

bindsym $mod+Return exec --no-startup-id $term
bindsym $mod+d exec --no-startup-id pocketchip-menu
bindsym $mod+Shift+q kill
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exit

bindsym $mod+Shift+slash exec --no-startup-id $term -geometry 74x18 -e sh -lc 'less /usr/share/doc/pocketchip/i3-cheatsheet.md'
bindsym $mod+i exec --no-startup-id $term -geometry 74x18 -e sh -lc 'pocketchip-about | less'
bindsym $mod+w exec --no-startup-id pocketchip-browser
bindsym $mod+Shift+w exec --no-startup-id pocketchip-browser light
bindsym $mod+Left exec --no-startup-id pocketchip-browser-action back
bindsym $mod+Right exec --no-startup-id pocketchip-browser-action forward
bindsym $mod+Up exec --no-startup-id pocketchip-browser-action page-up
bindsym $mod+Down exec --no-startup-id pocketchip-browser-action page-down
bindsym $mod+u exec --no-startup-id pocketchip-browser-action url
bindsym $mod+r exec --no-startup-id pocketchip-browser-action reload
bindsym $mod+Shift+f exec --no-startup-id pocketchip-browser-action fullscreen
bindsym $mod+m exec --no-startup-id pocketchip-menu
bindsym $mod+x exec --no-startup-id pocketchip-power menu
bindsym $mod+Escape exec --no-startup-id pocketchip-power lock
bindsym $mod+Shift+x exec --no-startup-id pocketchip-power low-lock
bindsym $mod+Shift+c exec --no-startup-id pocketchip-power caffeine
bindsym $mod+Shift+p exec --no-startup-id pocketchip-power performance
bindsym $mod+n exec --no-startup-id $term -e pocketchip-connect wifi
bindsym $mod+b exec --no-startup-id $term -e pocketchip-connect bt
bindsym $mod+Shift+n exec --no-startup-id $term -e pocketchip-connect menu
bindsym $mod+c exec --no-startup-id $term -geometry 74x16 -e pocketchip-control menu
bindsym $mod+v exec --no-startup-id $term -geometry 74x18 -e pocketchip-control volume
bindsym $mod+Shift+v exec --no-startup-id $term -geometry 74x14 -e pocketchip-control brightness
bindsym $mod+Shift+t exec --no-startup-id $term -hold -geometry 74x14 -e pocketchip-touch-calibrate menu

bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

bindsym $mod+f exec --no-startup-id pocketchip-browser-action fullscreen
bindsym $mod+space focus mode_toggle
bindsym $mod+Shift+space floating toggle

bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4
bindsym $mod+Shift+1 move container to workspace number 1
bindsym $mod+Shift+2 move container to workspace number 2
bindsym $mod+Shift+3 move container to workspace number 3
bindsym $mod+Shift+4 move container to workspace number 4

bindsym XF86MonBrightnessUp exec --no-startup-id pocketchip-control brightness-up
bindsym XF86MonBrightnessDown exec --no-startup-id pocketchip-control brightness-down
bindsym XF86AudioRaiseVolume exec --no-startup-id pocketchip-control volume-up
bindsym XF86AudioLowerVolume exec --no-startup-id pocketchip-control volume-down
bindsym XF86AudioMute exec --no-startup-id pocketchip-control volume-mute
bindsym $mod+equal exec --no-startup-id pocketchip-control brightness-up
bindsym $mod+minus exec --no-startup-id pocketchip-control brightness-down
bindsym $mod+period exec --no-startup-id pocketchip-control volume-up
bindsym $mod+comma exec --no-startup-id pocketchip-control volume-down
bindsym $mod+slash exec --no-startup-id pocketchip-control volume-mute

exec --no-startup-id pocketchip-touch-calibrate apply
exec --no-startup-id pocketchip-splash desktop
exec --no-startup-id pocketchip-gestures
exec --no-startup-id sh -lc 'pocketchip-first-login-password --needed && xterm -bg black -fg green -cr green -fa "DejaVu Sans Mono" -fs 7 -geometry 74x14 -e pocketchip-first-login-password || true'
exec --no-startup-id xsetroot -cursor_name crosshair

bar {
    status_command /usr/local/bin/pocketchip-status
    position top
    tray_output none
    colors {
        background #000000
        statusline #00ff66
        separator #2a8f52
        focused_workspace #00ff66 #002b16 #00ff66
        active_workspace #00331a #00331a #00ff66
        inactive_workspace #000000 #000000 #00aa44
        urgent_workspace #ff5f5f #330000 #ffffff
    }
}
