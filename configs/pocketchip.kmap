# PocketCHIP Linux console keymap.
# Right Alt is the PocketCHIP Fn/AltGr layer.

keymaps 0-2,4-6,8-9,12

keycode 1 = Escape
keycode 2 = one
  shift keycode 2 = exclam
  altgr keycode 2 = one
keycode 3 = two
  shift keycode 3 = at
  altgr keycode 3 = two
keycode 4 = three
  shift keycode 4 = numbersign
  altgr keycode 4 = three
keycode 5 = four
  shift keycode 5 = dollar
  altgr keycode 5 = four
keycode 6 = five
  shift keycode 6 = percent
  altgr keycode 6 = five
keycode 7 = six
  shift keycode 7 = asciicircum
  altgr keycode 7 = six
keycode 8 = seven
  shift keycode 8 = ampersand
  altgr keycode 8 = seven
keycode 9 = eight
  shift keycode 9 = asterisk
  altgr keycode 9 = eight
keycode 10 = nine
  shift keycode 10 = parenleft
  altgr keycode 10 = nine
keycode 11 = zero
  shift keycode 11 = parenright
  altgr keycode 11 = zero
keycode 13 = plus
  shift keycode 13 = equal
  altgr keycode 13 = plus
keycode 14 = BackSpace
  altgr keycode 14 = BackSpace
keycode 15 = Tab

keycode 16 = +q
keycode 17 = +w
keycode 18 = +e
keycode 19 = +r
keycode 20 = +t
keycode 21 = +y
  altgr keycode 21 = braceleft
keycode 22 = +u
  altgr keycode 22 = braceright
keycode 23 = +i
  altgr keycode 23 = bracketleft
keycode 24 = +o
  altgr keycode 24 = bracketright
keycode 25 = +p
  altgr keycode 25 = bar

keycode 28 = Return
  altgr keycode 28 = KP_Enter
keycode 29 = Control
keycode 30 = +a
keycode 31 = +s
keycode 32 = +d
keycode 33 = +f
keycode 34 = +g
keycode 35 = +h
  altgr keycode 35 = less
keycode 36 = +j
  altgr keycode 36 = greater
keycode 37 = +k
  altgr keycode 37 = apostrophe
keycode 38 = +l
  altgr keycode 38 = quotedbl

keycode 42 = Shift
keycode 44 = +z
keycode 45 = +x
keycode 46 = +c
keycode 47 = +v
keycode 48 = +b
  altgr keycode 48 = grave
keycode 49 = +n
  altgr keycode 49 = asciitilde
keycode 50 = +m
  altgr keycode 50 = colon
keycode 52 = period
  shift keycode 52 = comma
  altgr keycode 52 = semicolon
keycode 53 = slash
  shift keycode 53 = question
  altgr keycode 53 = backslash
keycode 54 = Shift
keycode 56 = AltGr
keycode 57 = space

keycode 74 = minus
  shift keycode 74 = underscore
  altgr keycode 74 = minus
keycode 97 = Control
keycode 100 = Alt
keycode 103 = Up
  altgr keycode 103 = Up
keycode 105 = Left
  altgr keycode 105 = Left
keycode 106 = Right
  altgr keycode 106 = Right
keycode 108 = Down
  altgr keycode 108 = Down
