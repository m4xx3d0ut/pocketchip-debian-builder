#!/bin/sh
set -eu

active_class() {
  command -v xdotool >/dev/null 2>&1 || return 1
  id="$(xdotool getactivewindow 2>/dev/null || true)"
  [ -n "$id" ] || return 1
  xdotool getwindowclassname "$id" 2>/dev/null || true
}

browser_active() {
  class="$(active_class || true)"
  printf '%s\n' "$class" | grep -Eiq 'firefox|navigator|netsurf|chromium|browser'
}

send_key() {
  command -v xdotool >/dev/null 2>&1 || exit 0
  xdotool key "$@"
}

fallback_i3() {
  command -v i3-msg >/dev/null 2>&1 || exit 0
  i3-msg "$@" >/dev/null
}

cmd="${1:-help}"
case "$cmd" in
  back)
    if browser_active; then send_key Alt+Left; else fallback_i3 workspace prev; fi
    ;;
  forward)
    if browser_active; then send_key Alt+Right; else fallback_i3 workspace next; fi
    ;;
  page-up)
    if browser_active; then send_key Page_Up; else fallback_i3 focus up; fi
    ;;
  page-down)
    if browser_active; then send_key Page_Down; else fallback_i3 exec pocketchip-menu; fi
    ;;
  url)
    browser_active && send_key Ctrl+l
    ;;
  find)
    browser_active && send_key Ctrl+f
    ;;
  reload)
    browser_active && send_key Ctrl+r
    ;;
  fullscreen)
    browser_active && send_key F11
    ;;
  menu)
    fallback_i3 exec pocketchip-menu
    ;;
  terminal)
    fallback_i3 exec xterm -bg black -fg green -cr green -fa "DejaVu Sans Mono" -fs 7
    ;;
  *)
    cat <<'EOF'
Usage: pocketchip-browser-action back|forward|page-up|page-down|url|find|reload|fullscreen|menu|terminal
EOF
    exit 2
    ;;
esac
