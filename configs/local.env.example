# Optional local image and bootloader settings for build scripts.
# Copy to configs/local.env. That file is gitignored because it may contain secrets.

# Image/security defaults.
POCKETCHIP_IMAGE_PROFILE=balanced
POCKETCHIP_ROOT_AUTH=locked
POCKETCHIP_SPECTRE_V2_MITIGATION=1

# Account defaults. Leave POCKETCHIP_USER_PASSWORD empty for tty1 autologin
# and first-login password setup. Set POCKETCHIP_ROOT_AUTH=password only for
# lab/recovery images that intentionally need a root password.
POCKETCHIP_USER=chip
POCKETCHIP_USER_PASSWORD=
# POCKETCHIP_ROOT_PASSWORD=temporary-lab-password

# auto: tty1 autologin is enabled only when POCKETCHIP_USER_PASSWORD is empty.
# Use 1 or 0 to force a behavior.
POCKETCHIP_AUTOLOGIN_TTY1=auto
POCKETCHIP_BOOT_TO_I3=1
POCKETCHIP_FIRST_LOGIN_PASSWORD_SETUP=auto

# The PocketCHIP RTL8723BS Wi-Fi is 2.4 GHz only.
# POCKETCHIP_WIFI_SSID='your-2g-ssid'
# POCKETCHIP_WIFI_PSK='your-password'
# POCKETCHIP_WIFI_HIDDEN=0
POCKETCHIP_WIFI_COUNTRY=US

# Xorg runtime touch calibration matrix. Presets are available from:
# pocketchip-touch-calibrate menu
POCKETCHIP_TOUCH_MATRIX='-1 0 1 0 -1.18 1.09 0 0 1'
POCKETCHIP_TOUCH_OUTPUT=

# Optional local assets. Relative paths are resolved from POCKETCHIP_ASSET_DIR,
# which should point at ignored local files. Keep personal artwork out of git.
# Leave image names commented for a publish-safe build that does not depend on
# .local/ files.
POCKETCHIP_ASSET_DIR='.local/chip-assets'
# POCKETCHIP_BG_IMAGE=bg.png
POCKETCHIP_BG_TOP_MARGIN=14
# Optional static splash. The image is copied as PNG and converted to a 480x272
# raw /dev/fb0 blob at build time; no video playback stack is installed.
# POCKETCHIP_SPLASH_IMAGE=splash.png
POCKETCHIP_SPLASH_TOP_MARGIN=14
POCKETCHIP_BOOT_SPLASH=0
POCKETCHIP_BOOT_SPLASH_HOLD=0
POCKETCHIP_LOGIN_SPLASH=auto
POCKETCHIP_LOGIN_SPLASH_HOLD=0

# Desktop defaults.
POCKETCHIP_BROWSER=firefox-esr
POCKETCHIP_GESTURES=1
POCKETCHIP_DARK_MODE=1
POCKETCHIP_TIMEZONE=America/Los_Angeles
# Enable network date/time sync with systemd-timesyncd after Wi-Fi is online.
POCKETCHIP_NETWORK_TIME=1
POCKETCHIP_FIREFOX_SCALE=1.15
POCKETCHIP_FIREFOX_DEFAULT_ZOOM=1.0
POCKETCHIP_BROWSER_FULLSCREEN=1
POCKETCHIP_BROWSER_TOUCH_MODE=gestures
