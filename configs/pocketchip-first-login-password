#!/bin/sh
set -eu

if [ -r /etc/default/pocketchip-user ]; then
  # shellcheck disable=SC1091
  . /etc/default/pocketchip-user
fi
if [ -r /etc/default/pocketchip-ui ]; then
  # shellcheck disable=SC1091
  . /etc/default/pocketchip-ui
fi

stamp=/var/lib/pocketchip/password-setup-done
user="${POCKETCHIP_USER:-${USER:-}}"

needed() {
  [ "${POCKETCHIP_FIRST_LOGIN_PASSWORD_SETUP:-0}" = 1 ] || return 1
  [ ! -e "$stamp" ] || return 1
  [ -n "$user" ] || return 1
  [ "${USER:-}" = "$user" ] || return 1
}

if [ "${1:-}" = --needed ]; then
  needed
  exit $?
fi

needed || exit 0

clear
cat <<EOF
PocketCHIP first-login password setup

This image booted directly into i3 for initial setup. Set a password for $user
now; after it succeeds, tty1 autologin will be disabled so the next boot is
password protected.

EOF

status="$(passwd -S "$user" 2>/dev/null | awk '{ print $2 }' || true)"
if [ "$status" != P ]; then
  if ! sudo -n /usr/local/sbin/pocketchip-disable-autologin --set-password "$user"; then
    printf '\nPassword was not changed. This prompt will return next i3 session.\n'
    printf 'Press Enter to close. '
    read -r _ || true
    exit 1
  fi
else
  printf 'Password is already set for %s; disabling tty1 autologin.\n' "$user"
  if ! sudo -n /usr/local/sbin/pocketchip-disable-autologin "$user"; then
    printf '\nPassword is set, but autologin could not be disabled automatically.\n' >&2
    printf 'Run: sudo /usr/local/sbin/pocketchip-disable-autologin %s\n' "$user" >&2
    printf 'Press Enter to close. '
    read -r _ || true
    exit 1
  fi
fi

printf '\nDone. Reboot to verify password-protected login.\n'
printf 'Press Enter to close. '
read -r _ || true
