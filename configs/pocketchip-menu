#!/bin/sh
set -eu

term() {
  exec xterm -bg black -fg green -cr green -fa "DejaVu Sans Mono" -fs 7 "$@"
}

run_choice() {
  case "$1" in
    "app: terminal"|terminal|term)
      term
      ;;
    "app: tmux"|tmux)
      term -e tmux new-session -A -s pocketchip
      ;;
    "app: nvim"|nvim|neovim|edit)
      term -e nvim
      ;;
    "app: htop"|htop|top)
      term -e htop
      ;;
    "app: browser"|browser|web)
      exec pocketchip-browser
      ;;
    "app: browser-light"|browser-light|web-light|netsurf)
      exec pocketchip-browser light
      ;;
    "net: wifi"|wifi)
      term -e pocketchip-connect wifi
      ;;
    "net: bluetooth"|bluetooth|bt)
      term -e pocketchip-connect bt
      ;;
    "net: connect"|connect|network)
      term -e pocketchip-connect menu
      ;;
    "ctl: touch"|touch)
      term -hold -geometry 74x14 -e pocketchip-touch-calibrate menu
      ;;
    "ctl: controls"|controls)
      term -geometry 74x16 -e pocketchip-control menu
      ;;
    "ctl: brightness"|brightness)
      term -geometry 74x14 -e pocketchip-control brightness
      ;;
    "ctl: volume"|volume|mixer|audio)
      term -geometry 74x18 -e pocketchip-control volume
      ;;
    "sys: about"|about|info|system)
      term -geometry 74x18 -e sh -lc 'pocketchip-about | less'
      ;;
    "sys: help"|help|cheat|cheatsheet)
      term -geometry 74x18 -e sh -lc 'less /usr/share/doc/pocketchip/i3-cheatsheet.md'
      ;;
    "sys: status"|status)
      term -hold -e pocketchip-status
      ;;
    "power: menu"|power)
      exec pocketchip-power menu
      ;;
    "power: lock"|lock)
      exec pocketchip-power lock
      ;;
    "power: low-lock"|low-power|low-power-lock|low-lock)
      exec pocketchip-power low-lock
      ;;
    "power: performance"|performance|perf)
      exec pocketchip-power performance
      ;;
    "power: normal"|radios-on|normal)
      exec pocketchip-power normal
      ;;
    *)
      printf 'unknown PocketCHIP menu choice: %s\n' "$1" >&2
      exit 2
      ;;
  esac
}

if [ "${1:-}" ]; then
  run_choice "$1"
fi

choices='app: terminal
app: tmux
app: nvim
app: htop
app: browser
app: browser-light
net: wifi
net: bluetooth
net: connect
ctl: controls
ctl: brightness
ctl: volume
ctl: touch
sys: status
sys: about
sys: help
power: menu
power: lock
power: low-lock
power: performance
power: normal'

if [ -n "${DISPLAY:-}" ] && command -v dmenu >/dev/null 2>&1; then
  choice="$(printf '%s\n' "$choices" | dmenu -i -p chip)"
else
  printf '%s\n' "$choices"
  printf 'choice: '
  read -r choice
fi

[ -n "${choice:-}" ] || exit 0
run_choice "$choice"
