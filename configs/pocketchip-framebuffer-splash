#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu

if [ -r /etc/default/pocketchip-ui ]; then
  # shellcheck disable=SC1091
  . /etc/default/pocketchip-ui
fi

mode="${1:-paint}"
fb_device="${POCKETCHIP_FRAMEBUFFER_DEVICE:-/dev/fb0}"
splash_fb="${POCKETCHIP_SPLASH_FB_PATH:-/usr/share/pocketchip/splash.fb}"
expected_size="${POCKETCHIP_SPLASH_FB_SIZE:-522240}"
log_file="${POCKETCHIP_FB_SPLASH_LOG:-/run/pocketchip-framebuffer-splash.log}"

touch_log() {
  : >>"$1"
}

if ! touch_log "$log_file" 2>/dev/null; then
  log_file=/tmp/pocketchip-framebuffer-splash.log
  if ! touch_log "$log_file" 2>/dev/null; then
    log_file=/dev/null
  fi
fi

log() {
  printf '%s\n' "$*" >>"$log_file" 2>/dev/null || true
}

file_size() {
  wc -c <"$1" | tr -d '[:space:]'
}

framebuffer_info() {
  if command -v fbset >/dev/null 2>&1; then
    fbset -fb "$fb_device" -i 2>/dev/null || true
  fi
}

paint() {
  enabled="${POCKETCHIP_BOOT_SPLASH:-0}"
  hold="${POCKETCHIP_BOOT_SPLASH_HOLD:-0}"
  label="boot"
  if [ "$mode" = login ]; then
    enabled="${POCKETCHIP_LOGIN_SPLASH:-0}"
    hold="${POCKETCHIP_LOGIN_SPLASH_HOLD:-0}"
    label="login"
  fi

  if [ "$enabled" != 1 ]; then
    log "$label splash disabled"
    return 0
  fi
  tries=0
  while [ ! -c "$fb_device" ] && [ "$tries" -lt 25 ]; do
    tries=$((tries + 1))
    sleep 0.2
  done
  if [ ! -c "$fb_device" ]; then
    log "framebuffer device missing: $fb_device"
    return 0
  fi
  if [ ! -r "$splash_fb" ]; then
    log "splash framebuffer blob not readable: $splash_fb"
    return 0
  fi

  size="$(file_size "$splash_fb")"
  if [ "$size" != "$expected_size" ]; then
    log "unexpected splash framebuffer size: $size, expected $expected_size"
    return 1
  fi

  setterm -cursor off -blank 0 -powersave off >/dev/tty0 2>/dev/null || true
  dd if="$splash_fb" of="$fb_device" bs="$expected_size" count=1 status=none
  log "painted $label splash $splash_fb to $fb_device"
  case "$hold" in
    ''|*[!0-9]*) hold=0 ;;
  esac
  if [ "$hold" -gt 0 ]; then
    log "holding $label splash for ${hold}s"
    sleep "$hold"
  fi
}

status() {
  printf 'POCKETCHIP_BOOT_SPLASH=%s\n' "${POCKETCHIP_BOOT_SPLASH:-0}"
  printf 'POCKETCHIP_BOOT_SPLASH_HOLD=%s\n' "${POCKETCHIP_BOOT_SPLASH_HOLD:-0}"
  printf 'POCKETCHIP_LOGIN_SPLASH=%s\n' "${POCKETCHIP_LOGIN_SPLASH:-0}"
  printf 'POCKETCHIP_LOGIN_SPLASH_HOLD=%s\n' "${POCKETCHIP_LOGIN_SPLASH_HOLD:-0}"
  printf 'POCKETCHIP_SPLASH_TOP_MARGIN=%s\n' "${POCKETCHIP_SPLASH_TOP_MARGIN:-0}"
  printf 'POCKETCHIP_FRAMEBUFFER_DEVICE=%s\n' "$fb_device"
  printf 'POCKETCHIP_SPLASH_FB_PATH=%s\n' "$splash_fb"
  printf 'POCKETCHIP_SPLASH_FB_SIZE=%s\n' "$expected_size"
  if [ -r "$splash_fb" ]; then
    printf 'ACTUAL_SPLASH_FB_SIZE=%s\n' "$(file_size "$splash_fb")"
  else
    printf 'ACTUAL_SPLASH_FB_SIZE=missing\n'
  fi
  framebuffer_info
  if [ -r "$log_file" ]; then
    printf '\nLast framebuffer splash log:\n'
    tail -n 8 "$log_file"
  fi
}

case "$mode" in
  paint|boot|login)
    paint
    ;;
  status)
    status
    ;;
  *)
    printf 'usage: pocketchip-framebuffer-splash [paint|boot|login|status]\n' >&2
    exit 2
    ;;
esac
