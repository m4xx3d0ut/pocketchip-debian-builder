#!/bin/sh
set -eu

if [ "$(id -u)" -ne 0 ]; then
  printf 'pocketchip-disable-autologin must run as root\n' >&2
  exit 1
fi

if [ -r /etc/default/pocketchip-user ]; then
  # shellcheck disable=SC1091
  . /etc/default/pocketchip-user
fi

stamp=/var/lib/pocketchip/password-setup-done
set_password=0
if [ "${1:-}" = --set-password ]; then
  set_password=1
  shift
fi

user="${1:-${POCKETCHIP_USER:-}}"
[ -n "$user" ] || {
  printf 'missing user\n' >&2
  exit 2
}

if [ -n "${POCKETCHIP_USER:-}" ] && [ "$user" != "$POCKETCHIP_USER" ]; then
  printf 'refusing to modify autologin for unexpected user: %s\n' "$user" >&2
  exit 2
fi

if [ "$set_password" = 1 ]; then
  if [ -e "$stamp" ]; then
    printf 'first-login password setup is already complete\n' >&2
    exit 1
  fi
  passwd "$user"
fi

status="$(passwd -S "$user" 2>/dev/null | awk '{ print $2 }' || true)"
if [ "$status" != P ]; then
  printf 'refusing to disable autologin before %s has a password\n' "$user" >&2
  exit 1
fi

rm -f /etc/systemd/system/getty@tty1.service.d/autologin.conf
rmdir /etc/systemd/system/getty@tty1.service.d 2>/dev/null || true
if getent group sudo >/dev/null 2>&1; then
  usermod -aG sudo "$user"
fi
if getent group pocketchip-setup >/dev/null 2>&1; then
  gpasswd -d "$user" pocketchip-setup >/dev/null 2>&1 || true
fi
mkdir -p /var/lib/pocketchip
touch "$stamp"
systemctl daemon-reload 2>/dev/null || true
