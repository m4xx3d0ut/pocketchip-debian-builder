#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only
set -eu

if [ -r /etc/default/pocketchip-ui ]; then
  # shellcheck disable=SC1091
  . /etc/default/pocketchip-ui
fi

log_file="${POCKETCHIP_BOOT_ANIMATION_LOG:-/tmp/pocketchip-boot-animation.log}"
: >"$log_file" 2>/dev/null || log_file=/dev/null

log() {
  printf '%s\n' "$*" >>"$log_file" 2>/dev/null || true
}

if [ "${POCKETCHIP_BOOT_ANIMATION:-0}" != 1 ]; then
  log "disabled"
  exit 0
fi

video="${POCKETCHIP_BOOT_VIDEO_PATH:-/usr/share/pocketchip/boot.mp4}"
if [ ! -r "$video" ]; then
  log "video not readable: $video"
  exit 0
fi
if ! command -v mpv >/dev/null 2>&1; then
  log "mpv not installed"
  exit 0
fi

log "playing $video"
timeout "${POCKETCHIP_BOOT_ANIMATION_TIMEOUT:-8}" \
  mpv --really-quiet --no-config --fs --no-audio --vo=x11 --no-terminal "$video" \
  >>"$log_file" 2>&1 || log "mpv exited non-zero"
